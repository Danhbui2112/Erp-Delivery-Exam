<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_erp_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.erp.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_erp_project"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    string="ERP Delivery Project"
                    invisible="erp_project_count == 0"
                >
                    <field name="erp_project_count" widget="statinfo" string="ERP Delivery Project"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_erp_project"
                    type="object"
                    string="Create ERP Project"
                    class="oe_highlight"
                    groups="erp_delivery_core.group_erp_delivery_consultant"
                    invisible="state not in ['sale', 'done'] or erp_project_count &gt; 0"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field
                    name="erp_solution_id"
                    string="ERP Solution"
                    optional="show"
                    domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                />
            </xpath>
        </field>
    </record>
</odoo>