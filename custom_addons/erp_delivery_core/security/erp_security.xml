<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erp_delivery_management" model="ir.module.category">
        <field name="name">ERP Delivery Management</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_erp_delivery_management" model="res.groups.privilege">
        <field name="name">ERP Delivery Management</field>
        <field name="category_id" ref="erp_delivery_core.module_category_erp_delivery_management"/>
    </record>

    <record id="group_erp_delivery_user" model="res.groups">
        <field name="name">User - Read only</field>
        <field name="privilege_id" ref="erp_delivery_core.privilege_erp_delivery_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_erp_delivery_consultant" model="res.groups">
        <field name="name">Consultant</field>
        <field name="privilege_id" ref="erp_delivery_core.privilege_erp_delivery_management"/>
        <field name="implied_ids" eval="[(4, ref('erp_delivery_core.group_erp_delivery_user'))]"/>
    </record>
    <record id="group_erp_delivery_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="erp_delivery_core.privilege_erp_delivery_management"/>
        <field name="implied_ids" eval="[(4, ref('erp_delivery_core.group_erp_delivery_consultant'))]"/>
    </record>

    <record id="rule_project_project_company" model="ir.rule">
        <field name="name">ERP Delivery Projects: allowed companies</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_erp_solution_company" model="ir.rule">
        <field name="name">ERP Solutions: allowed companies</field>
        <field name="model_id" ref="model_erp_solution"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_project_erp_module_company" model="ir.rule">
        <field name="name">ERP Project Modules: allowed companies</field>
        <field name="model_id" ref="model_project_erp_module"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_project_project_consultant_scope" model="ir.rule">
        <field name="name">ERP Delivery Consultant: assigned projects only</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">user.has_group('erp_delivery_core.group_erp_delivery_consultant') and not user.has_group('erp_delivery_core.group_erp_delivery_manager') and ['|', ('user_id', '=', user.id), ('erp_member_ids', 'in', user.id)] or []</field>
    </record>
    <record id="rule_project_project_manager" model="ir.rule">
        <field name="name">ERP Delivery Manager: allowed-company projects</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[(4, ref('erp_delivery_core.group_erp_delivery_manager'))]"/>
    </record>
</odoo>