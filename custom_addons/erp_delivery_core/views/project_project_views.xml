<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_form_erp_delivery_core" model="ir.ui.view">
        <field name="name">project.project.form.erp.delivery.core</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_golive"
                    type="object"
                    string="Go Live"
                    class="oe_highlight"
                    groups="erp_delivery_core.group_erp_delivery_consultant"
                    invisible="delivery_state == 'golive'"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="erp_delivery" string="ERP Delivery">
                    <group>
                        <group string="Delivery Details">
                            <field name="project_code" readonly="1"/>
                            <field name="is_erp_delivery"/>
                            <field name="delivery_state"/>
                            <field name="customer_code" readonly="1"/>
                            <field name="health_status" readonly="1" widget="badge"/>
                            <field name="go_live_expected_date"/>
                            <field name="go_live_actual_date" readonly="1"/>
                            <field name="duration_days"/>
                            <field name="contract_value" groups="erp_delivery_core.group_erp_delivery_manager"/>
                            <field name="contract_value" groups="!erp_delivery_core.group_erp_delivery_manager" readonly="1"/>
                        </group>
                        <group string="Delivery Metrics">
                            <field name="erp_member_ids" widget="many2many_tags" groups="erp_delivery_core.group_erp_delivery_manager"/>
                            <field name="erp_member_ids" widget="many2many_tags" groups="!erp_delivery_core.group_erp_delivery_manager" readonly="1"/>
                            <field name="module_count" readonly="1"/>
                            <field name="planned_effort_total" readonly="1"/>
                            <field name="actual_effort_total" readonly="1"/>
                            <field name="mandatory_task_count" readonly="1"/>
                            <field name="mandatory_task_done_count" readonly="1"/>
                            <field name="progress_rate" readonly="1"/>
                        </group>
                    </group>
                    <group string="ERP Modules">
                        <field name="erp_module_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="solution_id"/>
                                <field name="lead_consultant_id"/>
                                <field name="planned_effort"/>
                                <field name="actual_effort"/>
                                <field name="price"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_search_erp_delivery" model="ir.ui.view">
        <field name="name">project.project.search.erp.delivery</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="project_code" groups="erp_delivery_core.group_erp_delivery_user"/>
                <field name="delivery_state" groups="erp_delivery_core.group_erp_delivery_user"/>
                <field name="health_status" groups="erp_delivery_core.group_erp_delivery_user"/>
                <filter
                    name="expected_golive_date"
                    string="Expected Go-Live"
                    date="go_live_expected_date"
                    groups="erp_delivery_core.group_erp_delivery_user"
                />
                <filter
                    name="delivery_at_risk"
                    string="At Risk or Critical"
                    domain="[('health_status', 'in', ['amber', 'red'])]"
                    groups="erp_delivery_core.group_erp_delivery_user"
                />
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter
                    name="group_delivery_state"
                    string="Delivery Status"
                    context="{'group_by': 'delivery_state'}"
                    groups="erp_delivery_core.group_erp_delivery_user"
                />
                <filter
                    name="group_delivery_health"
                    string="Delivery Health"
                    context="{'group_by': 'health_status'}"
                    groups="erp_delivery_core.group_erp_delivery_user"
                />
                <filter
                    name="group_expected_golive_month"
                    string="Expected Go-Live Month"
                    context="{'group_by': 'go_live_expected_date:month'}"
                    groups="erp_delivery_core.group_erp_delivery_user"
                />
            </xpath>
        </field>
    </record>

    <record id="project_list_erp_delivery" model="ir.ui.view">
        <field name="name">project.project.list.erp.delivery</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="project_code" optional="show"/>
                <field name="delivery_state" widget="badge" optional="show"/>
                <field name="health_status" widget="badge" optional="show"/>
                <field name="go_live_expected_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_erp_delivery_projects" model="ir.actions.act_window">
        <field name="name">Delivery Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
        <field name="domain">[('is_erp_delivery', '=', True)]</field>
    </record>
</odoo>